# Copy to .env and fill in. Never commit .env.
# Use ONE of these (OpenAI is used when its key is set):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional
LLM_PROVIDER=
OPENAI_MODEL=gpt-5.4-mini
RIXIE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALLOWED_ORIGINS=
# Contact form -> your inbox (Gmail App Password: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=
